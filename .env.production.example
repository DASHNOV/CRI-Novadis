# Modèle du fichier .env de production, à placer dans /opt/cri-novadis/.env
# sur le serveur, à côté de docker-compose.yml.
#
#   cp .env.production.example .env   puis remplir chaque valeur
#
# Ces variables sont TOUTES obligatoires : docker-compose.yml les injecte dans
# le conteneur api, et l'API refuse de démarrer sans Jwt__SecretKey.
#
# ⚠️ Ce fichier n'est PAS sauvegardé par backup-server.sh et n'est PAS dans le
# dépôt. Ses valeurs doivent vivre dans un gestionnaire de mots de passe
# partagé — sans elles, le serveur ne peut pas être reconstruit.
# Voir docs/disaster-recovery.md.

# ── PostgreSQL ────────────────────────────────────────────────────────────
DB_NAME=cri_novadis
DB_USER=cri_user
DB_PASSWORD=remplacer_par_mot_de_passe_fort

# ── JWT ───────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 64
# Changer cette valeur invalide toutes les sessions en cours.
JWT_SECRET=remplacer_par_cle_aleatoire_64_caracteres_minimum

# ── Envoi d'e-mails — Microsoft Graph API (OAuth2) ────────────────────────
# Utilisé pour les codes de connexion OTP : sans ces valeurs, l'API démarre
# mais plus personne ne peut se connecter.
# Valeurs issues de l'inscription d'application dans Entra ID (Azure AD).
EMAIL_TENANT_ID=remplacer_par_id_du_tenant
EMAIL_CLIENT_ID=remplacer_par_id_de_l_application
EMAIL_CLIENT_SECRET=remplacer_par_secret_client
EMAIL_FROM=noreply@novadis.eu
EMAIL_FROM_NAME=Novadis CRI
